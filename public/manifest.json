{
  "manifest_version": 3,
  "name": "ClearVoice",
  "version": "0.5.0",
  "description": "Local-first browser tab audio capture, streaming processing, and AI transcription.",
  "permissions": [
    "tabCapture",
    "offscreen",
    "storage",
    "activeTab",
    "scripting"
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; connect-src 'self'; object-src 'self'"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "ClearVoice"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  }
}
